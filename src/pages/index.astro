    <script is:inline>
      // Scroll → capítulo. Menos de 1 KB, sem dependências. Sem JS ou com "reduzir movimento",
      // os três capítulos aparecem empilhados, cada um com sua imagem.
      (() => {
        const sec = document.querySelector(".seq");
        if (!sec || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const chapters = [...sec.querySelectorAll(".chapter")];
        let ticking = false;
        document.documentElement.classList.add("seq-on");
        const update = () => {
          ticking = false;
          const r = sec.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
          const k = Math.min(2, Math.floor(p * 3)); // cada imagem ocupa 1/3 do scroll
          sec.style.setProperty("--p1", Math.min(1, p * 3));
          sec.style.setProperty("--p2", Math.min(1, Math.max(0, p * 3 - 1)));
          sec.style.setProperty("--p3", Math.min(1, Math.max(0, p * 3 - 2)));
          sec.style.setProperty("--local", Math.min(1, p * 3 - k)); // progresso dentro da imagem atual
          chapters.forEach((c, n) => c.classList.toggle("is-active", n === k));
        };
        addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
        addEventListener("resize", update);
        update();
      })();
    </script>

